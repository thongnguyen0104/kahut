# Copy to .env.local and fill in. On Vercel, set the same names under
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or the output of `npx supabase start` locally)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public key: browsers only use it to listen to Realtime and upload via signed URLs.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI quiz generation for superadmins (Google AI Studio → Get API key; free tier works).
# SECRET: server only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: models to try, in order (main model first, then fallbacks), comma-separated.
# Replaces AI_MODELS in lib/config.ts. See /admin/ai-logs for what each model did.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# Optional: max players per room (default 30).
# MAX_PLAYERS=30

# Optional: base URL encoded in the join QR code (defaults to the current origin).
# Useful in local dev to point phones at your LAN IP, e.g. http://192.168.1.20:3000
# NEXT_PUBLIC_SITE_URL=
